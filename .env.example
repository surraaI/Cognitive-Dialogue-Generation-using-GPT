APP_NAME="Cognitive Dialogue Backend"
ENV="dev"
LOG_LEVEL="info"

# --- Supabase (recommended) ---
# Project URL from the Supabase dashboard
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Anon or publishable key (for future REST client usage; not for direct Postgres)
SUPABASE_KEY="your_supabase_anon_or_publishable_key"

# Database password: Project Settings → Database → Database password (copy once).
# Used to build postgresql+asyncpg://postgres:...@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD="your_database_password"

# Optional explicit URL (overrides auto-build from SUPABASE_*)
# DATABASE_URL="postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Local Postgres (fallback if DATABASE_URL and Supabase password are unset) ---
# Uses database `postgres` (the default DB). Override DATABASE_URL if needed.
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"

LLM_PROVIDER="openai"
LLM_MODEL="gpt-4.1-mini"
OPENAI_API_KEY="your_openai_api_key"
# Optional API base override (useful for gateways/proxies)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Gemini option (set LLM_PROVIDER="gemini" and model e.g. gemini-1.5-flash)
# GEMINI_API_KEY="your_gemini_api_key"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
