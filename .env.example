# Cognitive Dialogue Generation Backend — Environment Configuration
# This is a template. Copy to .env and fill in your actual values.

# =============================================================================
# APP CONFIGURATION
# =============================================================================
APP_NAME="Cognitive Dialogue Backend"
ENV="dev"
LOG_LEVEL="info"

# =============================================================================
# DATABASE CONFIGURATION
# Choose ONE of the following options:
# =============================================================================

# Option 1: Supabase (Cloud PostgreSQL) — RECOMMENDED
# 1. Create a project at https://supabase.com/dashboard
# 2. Get SUPABASE_URL from: Project Settings → API → Project URL
# 3. Get SUPABASE_KEY from: Project Settings → API → anon (publishable) key
# 4. Get SUPABASE_DB_PASSWORD from: Project Settings → Database → Database Password
#    (This is the password shown once when creating the project — NOT the anon key)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="your_supabase_anon_or_publishable_key"
SUPABASE_DB_PASSWORD="your_database_password"

# Option 2: Explicit PostgreSQL Connection String
# Uncomment and set DATABASE_URL directly (overrides Supabase auto-build)
# DATABASE_URL="postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Option 3: Local PostgreSQL (for development)
# If DATABASE_URL and SUPABASE_DB_PASSWORD are unset, defaults to:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
# Requires: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16

# =============================================================================
# LLM PROVIDER CONFIGURATION
# Choose your AI model provider and set credentials
# =============================================================================

# Default: OpenAI
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_SECONDS=45

# Alternative: Google Gemini
# LLM_PROVIDER="gemini"
# LLM_MODEL="gemini-1.5-flash"
# GEMINI_API_KEY="your_gemini_api_key"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# GEMINI_TIMEOUT_SECONDS=45

# =============================================================================
# QUICK START GUIDE
# =============================================================================
# 1. Copy this file to .env:
#    $ cp .env.example .env
#
# 2. Set your database credentials (Supabase recommended):
#    - Sign up at https://supabase.com/dashboard
#    - Fill in SUPABASE_URL, SUPABASE_KEY, SUPABASE_DB_PASSWORD
#
# 3. Set your LLM API key:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Gemini: https://aistudio.google.com/app/apikey
#
# 4. Run database migrations:
#    $ alembic upgrade head
#
# 5. Start the development server:
#    $ uvicorn main:app --reload
#
# 6. Visit http://127.0.0.1:8000/ui/ in your browser
